# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# COMFYUI_API_URL: Runpod ComfyUI endpoint for image generation
# Example: https://pb9too1432d9ip-8188.proxy.runpod.net
# Server-side only (never expose to frontend)
COMFYUI_API_URL=

# QWEN_API_URL: Runpod Qwen Image 2.1 endpoint for text-to-image and image editing
# Example: https://xxxxx-5000.proxy.runpod.net
# Server-side only (never expose to frontend)
QWEN_API_URL=
